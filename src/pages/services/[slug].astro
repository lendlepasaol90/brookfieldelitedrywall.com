---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { services, serviceBySlug, type Service } from '../../data/services';
import { photo } from '../../lib/photos';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const url = `${site.url}/services/${s.slug}/`;
const related = s.related.map((slug) => serviceBySlug[slug]);

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: s.name,
    serviceType: s.name,
    description: s.description,
    url,
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'City', name: `${site.city}, ${site.stateAbbr}` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: s.name, item: url },
    ],
  },
  { '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={s.title} description={s.description} ogPhoto={s.photo} schema={schema}>
  <section class="page-hero">
    <div class="wrap page-hero-grid">
      <div class="page-hero-text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/services/">Services</a></li>
            <li aria-current="page">{s.name}</li>
          </ol>
        </nav>
        <h1>{s.h1}</h1>
        <p class="lead">{s.lede}</p>
        <a class="btn btn-forest" href="/estimate/" data-estimate-open data-service={s.slug}>Get a free estimate <Arrow /></a>
      </div>
      <figure class="reveal-img">
        <Picture src={photo(s.photo)} alt={s.photoAlt} widths={[640, 960, 1400]} sizes="(min-width: 56rem) 46vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <div class="section">
    <div class="wrap svc-layout">
      <div class="svc-main prose">
        <section class="opening">
          {s.intro.map((p) => <p>{p}</p>)}
        </section>

        <section>
          <h2>{s.what.h}</h2>
          {s.what.p.map((p) => <p>{p}</p>)}
        </section>

        <section>
          <h2>{s.situations.h}</h2>
          <div class="sit-grid">
            {s.situations.items.map((it) => (
              <div class="reveal"><h3>{it.t}</h3><p>{it.d}</p></div>
            ))}
          </div>
        </section>

        <section>
          <h2>{s.process.h}</h2>
          <ol class="steps rows">
            {s.process.steps.map((st) => (
              <li class="reveal"><h3>{st.t}</h3><p>{st.d}</p></li>
            ))}
          </ol>
        </section>

        <section>
          <h2>{s.materials.h}</h2>
          {s.materials.p.map((p) => <p>{p}</p>)}
        </section>

        <section>
          <h2>{s.benefits.h}</h2>
          <ul class="benefit-list">
            {s.benefits.items.map((b) => (
              <li class="reveal"><h3>{b.t}</h3><p>{b.d}</p></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Before and after</h2>
          <BeforeAfter id={`ba-${s.slug}`} before={s.ba.before} after={s.ba.after} beforeAlt={s.ba.beforeAlt} afterAlt={s.ba.afterAlt} />
        </section>

        <section class="local-box">
          <h2>{s.local.h}</h2>
          {s.local.p.map((p) => <p>{p}</p>)}
        </section>

        <section id="faq">
          <h2>Questions about {s.name.toLowerCase().replace('&', 'and')}</h2>
          <Faq items={s.faqs} />
        </section>
      </div>

      <aside class="aside-card on-dark">
        <h2>Price this job</h2>
        <p>Describe the work and attach a photo or two. You will get a written scope and price for {s.name.toLowerCase().replace('&', 'and')} in {site.city}.</p>
        <a class="btn btn-primary" href="/estimate/" data-estimate-open data-service={s.slug}>Get a free estimate</a>
        <nav aria-label="Related services">
          <h3>Related services</h3>
          {related.map((r) => <a href={`/services/${r.slug}/`}>{r.name}</a>)}
          <a href="/services/">All drywall services</a>
        </nav>
      </aside>
    </div>
  </div>

  <section class="section bg-ivory">
    <div class="wrap">
      <h2>Often needed alongside</h2>
      <div class="related">
        {related.map((r, i) => (
          <a href={`/services/${r.slug}/`} class="reveal" style={`--d:${i * 0.07}s`}>
            <figure><Picture src={photo(r.photo)} alt="" widths={[320, 560]} sizes="(min-width: 64rem) 22vw, 46vw" formats={['avif', 'webp']} loading="lazy" /></figure>
            <div><h3>{r.name}</h3><p>{r.short}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading={`Ready to talk about ${s.name.toLowerCase().replace('&', 'and').replace(' services', '')}?`} service={s.slug} />
</Base>
