---
import Base from '../layouts/Base.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { site, telHref } from '../config/site';

const title = 'Request a Free Drywall Estimate | Brookfield Elite Drywall';
const description = 'Request a free, written drywall estimate in Brookfield, WI. Tell us about the project, attach photos if you have them, and we will reply with scope and price.';
const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Free estimate', item: `${site.url}/estimate/` },
  ] },
];
---
<Base title={title} description={description} schema={schema} inlineForm>
  <section class="page-hero section" style="padding-bottom:var(--section)">
    <div class="wrap est-page">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li aria-current="page">Free estimate</li></ol>
        </nav>
        <h1 style="font-size:clamp(2.3rem,4.6vw,3.8rem)">Request a free estimate</h1>
        <p class="lead" style="margin-top:1.25rem">The more you can tell us, the closer the first figure will be. Photos help a great deal, especially for repairs.</p>
        <ul class="expect">
          <li><strong>We read it properly</strong>Every request is looked at by someone who does the work.</li>
          <li><strong>We reply with next steps</strong>A price from your photos where possible, or a time to come and measure.</li>
          <li><strong>You get it in writing</strong>Scope, finish level and schedule set out plainly. No obligation.</li>
        </ul>
        {(site.phone || site.email) && (
          <p style="margin-top:2rem">
            Prefer to talk? {site.phone && <a class="text-link" href={telHref}>{site.phone}</a>} {site.email && <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>}
          </p>
        )}
      </div>
      <div class="panel" id="estimate-form">
        <EstimateForm idPrefix="pg" />
      </div>
    </div>
  </section>
</Base>
<script>
  // Preselect a service when arriving as /estimate/?service=<slug>
  const slug = new URLSearchParams(location.search).get('service');
  if (slug) {
    const select = document.querySelector<HTMLSelectElement>('#pg-service');
    const opt = select?.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
    if (select && opt) select.value = opt.value;
  }
</script>
