---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Brookfield Elite Drywall" description="The page you were looking for could not be found." noindex>
  <section class="notfound wrap">
    <h1>That page is not here</h1>
    <p class="lead" style="margin:1.5rem auto 2rem">The address may have changed, or the link was mistyped. The pages below will get you back on track.</p>
    <p style="display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap"><a class="btn btn-forest" href="/">Go to the home page</a><a class="btn btn-line" href="/services/">Browse services</a></p>
  </section>
</Base>
